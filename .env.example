# Local Docker Postgres (docker compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talentsift_ai

# --- Supabase (production) ---
# App runtime: shared transaction-mode pooler (pgbouncer, IPv4-friendly, port 6543).
# IMPORTANT: do NOT include "?pgbouncer=true" — that query param is meant for
# Prisma's pooler-aware client. asyncpg doesn't recognize it and raises a
# ValueError (crashes every DB call). Our asyncpg pool already sets
# statement_cache_size=0 in code, which is what actually makes it PgBouncer-safe.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Migrations only (`talentsift db init`): direct/session connection (port 5432).
# Required because pooled transaction-mode connections don't reliably support
# the DDL statements migrations issue (CREATE EXTENSION/TABLE/INDEX).
# DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

MISTRAL_API_KEYS=key1,key2,key3,key4
MISTRAL_BASE_URL=https://api.mistral.ai/v1
PRODUCT_KEY_PEPPER=change-me-to-a-long-random-string
ADMIN_SESSION_SECRET=change-me-to-another-long-random-string

# Set to true in production (Vercel + Render both serve HTTPS).
# Keep false for local http://localhost development.
COOKIE_SECURE=false

PHOENIX_PROJECT_NAME=talentsift-ai
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
